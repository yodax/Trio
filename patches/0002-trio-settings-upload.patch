+    // MARK: - Full settings attached to the profile (docs/trio-settings-upload.md)
+
+    private typealias TrioSettingsAttachment = (payload: NightscoutTrioSettings, hash: String)
+
+    private static let trioSettingsSchemaVersion = 1
+    private static let trioSettingsHashKey = "trioSettingsUploadHash"
+    private static let trioSettingsDateKey = "trioSettingsUploadDate"
+    private static let trioSettingsMaxAge: TimeInterval = 23 * 3600
+    private static let trioSettingsMaxBytes = 200_000 // Nightscout rejects request bodies over 1 MB
+
+    private var trioSettingsAttachmentIsStale: Bool {
+        guard let last = UserDefaults.standard.object(forKey: Self.trioSettingsDateKey) as? Date else { return true }
+        return Date().timeIntervalSince(last) > Self.trioSettingsMaxAge
+    }
+
+    func settingsDidChange(_: TrioSettings) { scheduleTrioSettingsUpload(delay: 10, onlyIfStale: false) }
+    func preferencesDidChange(_: Preferences) { scheduleTrioSettingsUpload(delay: 10, onlyIfStale: false) }
+    func pumpSettingsDidChange(_: PumpSettings) { scheduleTrioSettingsUpload(delay: 10, onlyIfStale: false) }
+
+    /// Debounced profile upload so a settings change reaches Nightscout without waiting for a profile edit.
+    private func scheduleTrioSettingsUpload(delay: TimeInterval, onlyIfStale: Bool) {
+        processQueue.async { [weak self] in
+            guard let self = self else { return }
+            self.pendingTrioSettingsUpload?.cancel()
+            let workItem = DispatchWorkItem { [weak self] in
+                guard let self = self, !onlyIfStale || self.trioSettingsAttachmentIsStale else { return }
+                Task {
+                    do { try await self.uploadProfiles() } catch {
+                        debug(.nightscout, "Settings-triggered profile upload failed: \(error)")
+                    }
+                }
+            }
+            self.pendingTrioSettingsUpload = workItem
+            self.processQueue.asyncAfter(deadline: .now() + delay, execute: workItem)
+        }
+    }
+
+    private final class OneShot: @unchecked Sendable {
+        private let lock = NSLock()
+        private var fired = false
+        func claim() -> Bool {
+            lock.lock(); defer { lock.unlock() }
+            if fired { return false }
+            fired = true
+            return true
+        }
+    }
+
+    /// Returns nil (profile uploads without settings) on any error, on timeout, or when nothing changed
+    /// since the last attachment (a changed hash, or an attachment older than a day, is attached again).
+    private func makeTrioSettingsAttachment() async -> TrioSettingsAttachment? {
+        await withCheckedContinuation { (continuation: CheckedContinuation<TrioSettingsAttachment?, Never>) in
+            let gate = OneShot()
+            Task {
+                let result = await self.buildTrioSettingsAttachment()
+                if gate.claim() { continuation.resume(returning: result) }
+            }
+            Task {
+                try? await Task.sleep(nanoseconds: 10 * 1_000_000_000)
+                if gate.claim() {
+                    debug(.nightscout, "Trio settings attachment timed out; uploading profile without it")
+                    continuation.resume(returning: nil)
+                }
+            }
+        }
+    }
+
+    private func buildTrioSettingsAttachment() async -> TrioSettingsAttachment? {
+        guard let resolver = settingsExportResolver else { return nil }
+        do {
+            let stateModel = await MainActor.run { () -> SettingsExport.StateModel in
+                let model = SettingsExport.StateModel()
+                model.resolver = resolver
+                return model
+            }
+            let categories = Set(SettingsExport.StateModel.ExportCategory.allCases.filter { $0 != .metadata })
+            let rows = try await stateModel.buildExportRows(categories: categories).get()
+            var csv = stateModel.csvText(for: rows)
+            if csv.hasPrefix("\u{FEFF}") { csv.removeFirst() }
+
+            func payload(exportedAt: Date) -> NightscoutTrioSettings {
+                NightscoutTrioSettings(
+                    schemaVersion: Self.trioSettingsSchemaVersion,
+                    exportedAt: exportedAt,
+                    appVersion: Bundle.main.appDevVersion ?? "unknown",
+                    build: Bundle.main.infoDictionary?["CFBundleVersion"] as? String ?? "unknown",
+                    csv: csv,
+                    preferences: settingsManager.preferences,
+                    settings: settingsManager.settings,
+                    pumpSettings: settingsManager.pumpSettings
+                )
+            }
+
+            // Hash excludes the export timestamp, so only a real change (or the daily refresh) re-attaches.
+            let hashEncoder = JSONEncoder()
+            hashEncoder.outputFormatting = [.sortedKeys]
+            let digest = SHA256.hash(data: try hashEncoder.encode(payload(exportedAt: .distantPast)))
+            let hash = digest.map { String(format: "%02x", $0) }.joined()
+            if hash == UserDefaults.standard.string(forKey: Self.trioSettingsHashKey), !trioSettingsAttachmentIsStale {
+                return nil
+            }
+
+            let result = payload(exportedAt: Date())
+            let size = try JSONCoding.encoder.encode(result).count // same encoder as the upload
+            guard size <= Self.trioSettingsMaxBytes else {
+                debug(.nightscout, "Trio settings attachment too large (\(size) bytes); uploading profile without it")
+                return nil
+            }
+            return (result, hash)
+        } catch {
+            debug(.nightscout, "Trio settings attachment failed: \(error); uploading profile without it")
+            return nil
+        }
+    }
